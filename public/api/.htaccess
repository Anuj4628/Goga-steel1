# Disable directory listing
Options -Indexes

DirectoryIndex send-quote.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^send-quote/?$ send-quote.php [L,QSA]
  RewriteRule ^send-quote\.php$ send-quote.php [L,QSA]
</IfModule>

# CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
</IfModule>

# Security: Block direct web access to sensitive environment and config files
<FilesMatch "^(\.env|config\.php|config\.sample\.php)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
