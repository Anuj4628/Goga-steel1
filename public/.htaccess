<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Routes: Direct /api/send-quote and /api/send-quote.php directly to PHP handler
  RewriteRule ^api/send-quote/?$ api/send-quote.php [L,QSA]
  RewriteRule ^api/send-quote\.php$ api/send-quote.php [L,QSA]

  # 2. Pass existing files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Route Fallback: All react frontend paths pass to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Block direct access to environment and configuration files
<FilesMatch "^(\.env|config\.php|config\.sample\.php)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
