# Goga Stainless — Production cPanel Apache Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass existing files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Route Fallback: Route all frontend paths to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Block access to hidden files and dotfiles (.git, .env, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
