PORT=5000

# Gmail SMTP Settings:
# 1. Enable 2-Step Verification on info.gogastainless@gmail.com
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password (name: "Goga Website")
# 4. Paste the 16 characters below in SMTP_PASS (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info.gogastainless@gmail.com
SMTP_PASS=YOUR_16_CHAR_GMAIL_APP_PASSWORD_HERE
SMTP_FROM="Goga Stainless" <info.gogastainless@gmail.com>

# Business Inboxes (Inquiry Recipients)
BUSINESS_EMAIL=info.gogastainless@gmail.com
BUSINESS_CC_EMAIL=gogastainless@gmail.com
